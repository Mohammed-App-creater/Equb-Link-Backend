DJANGO_SECRET_KEY=your_django_secret_key_here
CHAPA_SECRET_KEY=your_chapa_secret_key_here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SMS for password reset: console (dev, prints the code) or afromessage
SMS_PROVIDER=console
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER_NAME=

# Security
CORS_ALLOWED_ORIGINS=https://equb-admin-panal.vercel.app
CHAPA_WEBHOOK_SECRET=
AUTH_TOKEN_TTL_DAYS=30
MAX_UPLOAD_MB=5
# Set both once the web server forwards X-Forwarded-Proto and redirects http->https
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
